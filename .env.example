# --- Database ---
DATABASE_URL="postgresql://user:password@localhost:5432/blogging?schema=public"

# --- Auth.js ---
AUTH_SECRET="generate-with-npx-auth-secret"
AUTH_URL="http://localhost:3000"

# OAuth providers (optional in development — credentials login always works)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# --- Email (Resend) ---
RESEND_API_KEY=""
# Until you verify a domain in the Resend dashboard, use their sandbox sender —
# it only delivers to the account owner's own email, but requires no setup.
EMAIL_FROM="Inkwell <onboarding@resend.dev>"

# --- Storage ---
UPLOADTHING_TOKEN=""

# --- AI (Groq) ---
# Used for AI-assisted title/excerpt/tag suggestions in the editor.
GROQ_API_KEY=""

# --- App ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional: require a verified e-mail to comment/publish (needs working e-mail delivery)
# REQUIRE_EMAIL_VERIFICATION=true
